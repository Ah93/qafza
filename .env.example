# Copy this file to .env.local and fill it in. .env.local is never committed.

# DeepSeek API key: builds lessons from uploaded material. Server-side only (never sent to the browser).
DEEPSEEK_API_KEY=

# Optional. Defaults to deepseek-chat.
DEEPSEEK_MODEL=deepseek-chat

# Signs the session cookies. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
AUTH_SECRET=

# Firestore (server-side only). Easiest: node scripts/load-firebase-key.mjs "<downloaded service-account .json>"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the \n escapes: the whole key stays on one line inside quotes
FIREBASE_PRIVATE_KEY=

# Email (Resend, https://resend.com). Without these the app prints each email to the server console and, outside
# production, hands codes and links back to the page so every flow can still be tried.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g.  قفزة <no-reply@yourdomain.com>
MAIL_FROM=
# The public address of the site, used for the links inside emails (required in production), e.g. https://qafza.example.com
APP_URL=

# Payments. "test" is a stand-in payment window that takes no money (development only, refused in production).
# A real provider is not connected yet.
BILLING_PROVIDER=

# Development only: confirm sign-ups without sending an email (ignored in production).
SKIP_EMAIL_VERIFICATION=
